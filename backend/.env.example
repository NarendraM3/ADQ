DATABASE_URL=sqlite:///./dq.db
LOCAL_DATA_DIR=./data
MAX_UPLOAD_MB=200
# Generate a stable key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# Grok (xAI) is also supported with AI_PROVIDER=grok.
GROK_API_KEY=
GROK_MODEL=grok-2-latest
AI_GROK_BASE_URL=https://api.x.ai/v1
ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com
AZURE_BLOB_ACCOUNT_URL_TEMPLATE=https://{account_name}.blob.core.windows.net
AI_TIMEOUT_SECONDS=45
AI_SUGGESTION_BATCH_SIZE=16
AI_SUGGESTION_CONCURRENCY=4
# AI suggestions use the OpenAI Python SDK. Set OPENAI_API_KEY and OPENAI_MODEL.
LOG_LEVEL=INFO
POSTGRES_DB=dq
POSTGRES_USER=dq
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Databricks SQL output destination (used when jobs retain the legacy local default)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=dq_catalog
DATABRICKS_SCHEMA=dq_schema

# Microsoft Fabric / OneLake
FABRIC_API_BASE=https://api.fabric.microsoft.com/v1
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_SOURCE_DIRECTORY=Files/dq/source
FABRIC_OUTPUT_DIRECTORY=Files/dq/outputs
FABRIC_SOURCE_TABLE=dq_source
FABRIC_PASS_TABLE=dq_pass_v2
FABRIC_FAIL_TABLE=dq_fail_v2
FABRIC_IGNORED_TABLE=dq_ignored_v2
FABRIC_JOB_POLL_SECONDS=2
FABRIC_JOB_TIMEOUT_SECONDS=900
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=

# Snowflake destination fallback
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
