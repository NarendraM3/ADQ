DATABASE_URL=sqlite:///./dq.db
LOCAL_DATA_DIR=./data
MAX_UPLOAD_MB=200
# Generate a stable key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
AI_PROVIDER=none
AI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=
AI_MODEL=
GROQ_MODEL=
AI_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com
AZURE_BLOB_ACCOUNT_URL_TEMPLATE=https://{account_name}.blob.core.windows.net
AI_TIMEOUT_SECONDS=45
# Built-in OpenAI-compatible endpoints: huggingface and groq. Set AI_BASE_URL for other providers.
LOG_LEVEL=INFO
POSTGRES_DB=dq
POSTGRES_USER=dq
POSTGRES_PASSWORD=replace-with-a-strong-local-password
